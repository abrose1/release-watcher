# This repo's Railway Postgres
DATABASE_URL=postgresql://user:pass@host:5432/release_watcher

# For ``scripts/sync_creators_remote.py`` or local alembic against Railway: same DB via **public** URL.
DATABASE_PUBLIC_URL=

# Public URL of taste-profile Railway Postgres (separate Railway project)
TASTE_PROFILE_DATABASE_URL=postgresql://user:pass@host:5432/taste_profile

# Spotify Developer App (same app as taste-profile repo)
# Client Credentials (client_id + client_secret) are used for artist album/single polling
# (daily scan). The weekly-discovery job also needs SPOTIFY_REFRESH_TOKEN because
# Spotify's playlist-items endpoint requires a user OAuth token as of Feb 2026.
# Generate the refresh token once via: python -m intake.playlists --auth
# (in the taste-profile repo; redirect: http://127.0.0.1:8888/callback).
# Copy the resulting token to the weekly-discovery-cron Railway service.
# The daily-scan service does NOT need SPOTIFY_REFRESH_TOKEN.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=

# TMDB API (free at themoviedb.org)
TMDB_API_KEY=your_tmdb_api_key

# Google Books API (free at console.cloud.google.com)
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# Brave Search API (free tier: 2000 queries/month)
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Preferred for US A2P 10DLC traffic — send via Messaging Service when set
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=+1234567890
# YOUR_PHONE_NUMBER is no longer used — recipients are managed via the sms_subscribers table.
# Text START to your Twilio number to begin the opt-in flow.

# Optional — merge into preferences.* on top of config.yaml (omit if you only use YAML override file)
SMS_GREETING_NAME=
SMS_FIRST_NAME=
SPOTIFY_SEED_PLAYLIST_IDS=id1,id2,id3
FILM_TASTE=
FILM_TMDB_GENRE_IDS=18,53,878
SMS_QUIET_TIMEZONE=America/Los_Angeles